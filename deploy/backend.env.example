# Install as /etc/pine/backend.env with mode 0600.
# Supply the API key through the host's secret-management workflow.
OPENAI_API_KEY=
PINE_OPENAI_MODEL=gpt-5.6
PINE_OPENAI_PROMPT_VERSION=finance-strategy-edge-extraction:v1
PINE_OPENAI_TIMEOUT_SECONDS=30
PINE_OPENAI_MAX_RETRIES=2
PINE_OPENAI_MAX_OUTPUT_TOKENS=4096
