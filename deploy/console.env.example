# Install as /etc/pine/console.env with mode 0600.
# This file contains configuration only. The backend token is a systemd credential.
PINE_CONSOLE_ALLOWED_HOST=
PINE_CONSOLE_ALLOWED_IDENTITIES=
PINE_CONSOLE_SOCKET_PATH=/run/pine/console.sock
PINE_CONSOLE_STATE_PATH=/var/lib/pine/console/console.db
PINE_CONSOLE_BACKEND_URL=http://127.0.0.1:8765
PINE_CONSOLE_LOG_LEVEL=info
