[Unit]
Description=Create a verified Pine Decision Edge vault backup
After=pine-backend.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment="PATH=/opt/decision-edge/current/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/decision-edge/current/venv/bin/pine-ledger-backup create --vault-root /var/lib/pine/vault --backup-root /var/backups/pine
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pine/vault /var/backups/pine
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
